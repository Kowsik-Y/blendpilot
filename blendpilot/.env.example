# BlendPilot AI — Environment Variables
# Copy this file to .env and fill in the values.

# === LLM Configuration (Phase 4+) ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-...

# === Blender Bridge (Phase 2+) ===
# BLENDER_BRIDGE_HOST=127.0.0.1
# BLENDER_BRIDGE_PORT=9876

# === Database (Phase 4+) ===
# DATABASE_URL=sqlite:///./blendpilot.db

# === Email MCP (Phase 9) ===
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=

# === General ===
LOG_LEVEL=INFO
OUTPUT_DIR=./output
