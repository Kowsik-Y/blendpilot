generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions ChatSession[]
  settings UserSettings?
  projects Project[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // LLM Configuration
  llmProvider    String @default("openai")
  llmModel       String @default("gpt-4o")
  llmApiKey      String @default("")
  llmBaseUrl     String @default("")
  llmTemperature Float  @default(0)
  llmMaxTokens   Int    @default(4096)

  // Context Window
  contextWindowSize Int     @default(128000)
  ragEnabled        Boolean @default(true)
  ragTopK           Int     @default(4)

  // Blender Connection
  blenderHost String @default("127.0.0.1")
  blenderPort Int    @default(9876)

  // Web Search Configuration
  tavilyApiKey String @default("")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
}

model Message {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String // "user", "assistant", "system"
  content    String
  metadata   String? // JSON: tool calls, agent steps, etc.
  tokenCount Int         @default(0)
  createdAt  DateTime    @default(now())
}

model Project {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  status     String   @default("pending")
  designSpec   String? // JSON DesignSpec
  sceneObjects String? // JSON array of WorkflowSceneObject
  outputDir    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions ChatSession[]
  memories Memory[]
}

model Memory {
  id        String   @id @default(cuid())
  content   String
  embedding Unsupported("vector(1536)")?
  sourceUrl String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}
